    <string name="drive_delete_file_trash">%1$s goes to the Trash, where you can restore it for %2$s. After that it is deleted for good. Its space is freed now, while it waits in the Trash.</string>
    <string name="drive_delete_file_permanent">Deleting %1$s is permanent. Only this account holds the key, so nobody — including Zekke — can restore it. Space from a deleted file returns within a minute, once both copies are removed.</string>
    <string name="drive_delete_folder_trash">“%1$s” goes to the Trash with %2$s. You can restore it, whole, for %3$s; after that it is deleted for good.</string>
    <string name="drive_delete_folder_permanent">Deleting “%1$s” also deletes %2$s, permanently.</string>
